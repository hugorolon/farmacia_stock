<service>
  <id>stock-backend</id>
  <name>Backend</name>
  <description>Servicio de backend en Spring Boot</description>
  
  <!-- Ruta a Java y argumentos para ejecutar el JAR -->
  <executable>C:\Program Files\Java\jdk-21.0.12.1\bin\java.exe</executable>
  <arguments>-jar "C:\unicosoft\stock-backend\target\stock-backend-0.1.jar"</arguments>
  
  <!-- Inicio automático con Windows -->
  <startmode>Automatic</startmode>
  
  <!-- Dependencia: reemplaza con el nombre exacto del Paso 2 -->
  <depend>postgresql-x64-16</depend>
  
  <!-- Reinicio automático en caso de fallo -->
  <onfailure action="restart" delay="10 sec"/>
  
  <!-- Carpeta para guardar los logs -->
  <logpath>C:\unicosoft\stock-backend\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
